DirectoryIndex index.html

# Ensure JS/CSS are served with correct MIME types (prevents nosniff blocking)
AddType text/css .css
AddType application/javascript .js
AddType application/javascript .mjs
AddType image/webp .webp
AddType image/svg+xml .svg

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Force HTTPS + www (production only — skip localhost / LAN)
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteCond %{HTTP_HOST} !^192\.168\. [NC]
RewriteCond %{HTTP_HOST} !^10\. [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.adamsglobalpublishers.com/$1 [L,R=301]

# Collapse double slashes
RewriteCond %{THE_REQUEST} \s[^?]*//+
RewriteRule ^(.*)$ /$1 [L,R=301]

# Old duplicate homepages
RewriteRule ^index-2\.html$ / [L,R=301]
RewriteRule ^index3\.html$ / [L,R=301]
RewriteRule ^index\.html$ / [L,R=301]
RewriteRule ^home/?$ / [L,R=301]

# Broken chat script URL -> contact
RewriteRule ^chat\.html$ /contact-us [L,R=301]

# Books listing page
RewriteRule ^books/?$ books.html [L]

# Book detail pages: /books/<slug> -> book-detail.html
RewriteRule ^books/([a-z0-9-]+)/?$ book-detail.html [L,QSA]

# Redirect any remaining *.html requests to clean slugs
RewriteCond %{THE_REQUEST} \s/+([^?\s]*?)\.html[\s?] [NC]
RewriteRule ^ /%1? [R=301,L]

# Internally serve clean URLs as .html files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Browser Caching — keep HTML short; assets long (cache-bust with ?v=)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# GZIP Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Don't let Cloudflare/browser keep stale HTML forever
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Block public access to form error log
<Files "form-errors.log">
  Require all denied
</Files>
